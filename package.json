{
  "name": "ygo-combo-assistant",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "e2e": "playwright test --project=e2e",
    "e2e:real": "playwright test --project=real-network",
    "audit:g11": "node scripts/g11-audit.mjs",
    "chatgpt-bridge": "node scripts/chatgpt-bridge/main.mjs",
    "test:bridge": "node --test scripts/chatgpt-bridge/bridge.test.mjs scripts/chatgpt-bridge/bridge-desktop.test.mjs scripts/chatgpt-bridge/bridge-refresh.test.mjs scripts/chatgpt-bridge/bridge-stream.test.mjs",
    "desktop:sidecar": "node scripts/desktop/build-sidecar.mjs",
    "test:sidecar": "node --test scripts/desktop/sidecar.test.mjs",
    "desktop:build": "npm run desktop:sidecar && tauri build",
    "e2e:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@anthropic-ai/sdk": "0.132.1",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-http": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "idb": "8.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0"
  }
}
